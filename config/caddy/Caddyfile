# Caddy in front of Odoo: TLS, the public site address and security headers.
# Odoo serves its own pages (HTTP on :8069) and live updates (/websocket, on
# the gevent worker, :8072, when workers > 0).
{
	# No admin API: config is static, reloads happen by restarting the container.
	admin off

	servers {
		# Behind a reverse proxy on a private network, log the real client IP
		# and pass its X-Forwarded-* headers on to Odoo (proxy_mode).
		trusted_proxies static private_ranges
		# Client IP = the right-most untrusted address (can't be spoofed).
		trusted_proxies_strict
	}
}

(odoo) {
	encode zstd gzip

	# Same variable as Odoo's upload limit (limit_request is per request count;
	# the size is limited here).
	request_body {
		max_size {$UPLOAD_MAX_SIZE}
	}

	# One directive per header: in a single `header { }` block, Caddy applies
	# the "?" (set if missing) fields together, only when all are missing.
	header ?X-Content-Type-Options nosniff
	header ?X-Frame-Options SAMEORIGIN
	header ?Referrer-Policy strict-origin-when-cross-origin
	header -Server

	# The database manager is disabled in Odoo (list_db = False); block its
	# pages anyway.
	@database_manager path /web/database/*
	respond @database_manager 403

	# Odoo (proxy_mode) takes the last X-Forwarded-For address as the client:
	# send only the real client IP, not the chain of proxies (e.g. Traefik).
	@websocket path /websocket /websocket/*
	reverse_proxy @websocket odoo:8072 {
		header_up X-Forwarded-For {client_ip}
	}

	reverse_proxy odoo:8069 {
		header_up X-Forwarded-For {client_ip}
		transport http {
			read_timeout 720s
			write_timeout 720s
		}
	}
}

# Public site. SITE_ADDRESS is ":80" for plain HTTP (local, or behind another
# proxy) or a domain name, which makes Caddy obtain and renew a certificate
# automatically ("localhost" uses Caddy's internal CA).
{$SITE_ADDRESS} {
	import odoo
	log {
		output stdout
	}
}

# Internal-only site (port not published) for the container healthcheck.
:8080 {
	import odoo
}
