# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8108.
ODOO_URL=http://localhost:8108
SITE_ADDRESS=:80
HTTP_PORT=8108
HTTPS_PORT=8408
MAILPIT_PORT=8025

# Dev-only secrets and credentials.
ODOO_MASTER_PASSWORD=master
DB_PASSWORD=odoo
ODOO_ADMIN_USER=admin
ODOO_ADMIN_PASSWORD=admin12345
ODOO_ADMIN_EMAIL=admin@example.com

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=erp@example.com

# Optional overrides (see overrides/*.yaml), combined with ":".
#COMPOSE_FILE=compose.yaml:overrides/addon.yaml
#ADDON_PATH=../my_addon
#ADDON_NAME=my_addon
