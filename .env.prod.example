# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=odoo

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST (the site's domain) is REQUIRED with
# it; the other three show their defaults.
#TRAEFIK_HOST=erp.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of Odoo (web.base.url, applied on every `up`).
ODOO_URL=https://erp.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=erp.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -base64 24)
# ---------------------------------------------------------------------------
# Odoo's master password (admin_passwd). The web database manager is
# disabled, but Odoo still requires it for some operations.
ODOO_MASTER_PASSWORD=
DB_PASSWORD=
# Admin user: only applied on the first install (changing them here later
# doesn't change the account).
ODOO_ADMIN_PASSWORD=
ODOO_ADMIN_EMAIL=
# Admin login (Odoo logins are often email addresses).
#ODOO_ADMIN_USER=admin
#DB_USER=odoo
# Database name (only this one is served).
#ODOO_DB=odoo

# ---------------------------------------------------------------------------
# Company and modules (initial settings, applied only on the first install)
# ---------------------------------------------------------------------------
#ODOO_COMPANY_NAME=Odoo
#ODOO_LANG=es_CL
#ODOO_COUNTRY=CL
#ODOO_CURRENCY=CLP
#ODOO_TIMEZONE=America/Santiago
# Modules to install, comma separated (checked on every `up`: modules added
# here later are installed too). `account` with country CL also installs the
# Chilean localization (l10n_cl). Empty = only the base apps.
#ODOO_MODULES=sale_management,account

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Odoo image tag (19.0-<date> = a weekly build of Odoo 19). A newer build of
# the same major version runs `-u all` on the next `up`; a new major version
# needs Odoo's upgrade process (setup refuses to start it). Back up first.
#ODOO_VERSION=19.0-20260908
#POSTGRES_VERSION=18
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31
# Mailpit's web UI port (mailpit profile, development only).
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Odoo server
# ---------------------------------------------------------------------------
# Worker processes (>= 1: live updates use the gevent worker). Rough sizing:
# 1 worker per ~6 concurrent users, (CPUs * 2) + 1 max.
#ODOO_WORKERS=2
#ODOO_CRON_THREADS=1
# Per-worker limits of VIRTUAL memory in bytes (Odoo's defaults; soft: the
# worker is recycled after the request, hard: allocations fail) and time
# limits in seconds. The real memory cap is ODOO_MEMORY_LIMIT (container).
#ODOO_LIMIT_MEMORY_SOFT=2147483648
#ODOO_LIMIT_MEMORY_HARD=2684354560
#ODOO_LIMIT_TIME_CPU=600
#ODOO_LIMIT_TIME_REAL=1200
#ODOO_LOG_LEVEL=info
# Developer features (e.g. "reload,xml" for addon development). Never in production.
#ODOO_DEV=
# Max request size (Caddy).
#UPLOAD_MAX_SIZE=128M

# ---------------------------------------------------------------------------
# Mail (SMTP): Odoo's default outgoing server (used unless mail servers are
# configured in Settings > Technical). Recommended, not required: without
# SMTP_HOST (or a server configured in Odoo) no mail is sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS, usually port 587) or none. Odoo's default mail server has no
# SMTPS (port 465): for that, add a server in Settings > Technical > Outgoing
# Mail Servers.
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Default sender address.
#SMTP_FROM=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#ODOO_MEMORY_LIMIT=2g
#SETUP_MEMORY_LIMIT=1536m
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
